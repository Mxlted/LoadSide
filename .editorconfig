root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{sh,yml,yaml,json}]
indent_size = 2

# Vendored headers retain upstream formatting.
[Sources/CArchive/**]
indent_size = unset
trim_trailing_whitespace = false
